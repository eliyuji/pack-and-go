# Copy this file to .env and fill in values. Never commit real secrets.

# Required for the Streamlit itinerary demo
GROQ_KEY=
# Groq retired llama-3.1-8b-instant on 2026-08-16; this is the official replacement.
GROQ_MODEL=openai/gpt-oss-20b

# YouTube Data API v3 key (Google Cloud → APIs & Services → Credentials)
YOUTUBE_API_KEY=

# GCS bucket that stores transcript .txt files, e.g. pag-transcripts
GCS_BUCKET_NAME=
# Absolute path to a GCP service account JSON with Storage Object Admin on that bucket
GOOGLE_APPLICATION_CREDENTIALS=

# Local Postgres (docker compose up -d postgres)
DATABASE_URL=postgresql://packandgo:packandgo@localhost:5432/packandgo

# Places API (Text Search) key. GOOGLE_PLACES is an alias if you already have that name.
GOOGLE_API_KEY=
GOOGLE_PLACES=

# Optional: Webshare proxy for youtube-transcript-api
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Streamlit -> FastAPI (docker-compose sets this automatically)
BACKEND_URL=http://127.0.0.1:8000
